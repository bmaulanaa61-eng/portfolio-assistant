# Backend-only Gemini/OpenAI-compatible credentials.
# Never put this value in Frontend/.env or any VITE_* variable.
AI_API_KEY="your-gemini-api-key-here"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL_NAME="gemini-3.5-flash-lite"

# Comma-separated allowed browser origins for CORS.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://datalabs-systems.web.app,https://datalabs-systems.firebaseapp.com"

# Abuse protection.
RATE_LIMIT_PER_MINUTE="10"
MAX_MESSAGE_CHARS="500"
LLM_TIMEOUT_SECONDS="25"
